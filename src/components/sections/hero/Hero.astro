---
import CtaButton from "../../shared/CtaButton.astro";
import GradiantText from "../../shared/GradiantText.astro";
import SubTitle from "../../shared/SubTitle.astro";
import Title from "../../shared/Title.astro";

const heroSection = {
  headline1: "Gestión Inmobiliaria ",
  headline2: "con Respaldo Legal: ",
  headline3: "Solidez para su Comunidad",
  subheading: "Administración transparente y asesoría experta para la tranquilidad y eficiencia de su comunidad.",
  buttonText: "Contáctanos",
};

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<section class=`relative  ${className} w-full min-h-[80vh]` id="hero">
  <div class="w-full min-h-[80vh] pt-[100px]">
    <div
      class="w-full h-full grid grid-cols-1 md:grid-cols-2 justify-end bg-base-100 dark:bg-base-dark-900"
    >
      <div class="justify-center flex flex-col text-center md:ml-auto pb-10 md:pb-0 px-4 md:px-8">
        <Title className="!text-4xl md:!text-6xl !leading-tight">
          {heroSection.headline1}
          <GradiantText>{heroSection.headline2}</GradiantText>
          {heroSection.headline3}
        </Title>
        <SubTitle className="mt-6 md:mt-10 leading-relaxed italic text-lg">
          {heroSection.subheading}
        </SubTitle>
        <div class="pt-8 md:pt-10">
          <CtaButton>{heroSection.buttonText}</CtaButton>
        </div>
      </div>
      <div class="flex relative pt-10 md:p-0">
        
        <img
          src="/portada.jpg"
          alt="Gestión Inmobiliaria"
          class="w-full h-full object-cover"
        />
        
        <svg
          class="fill-base-100 dark:fill-base-dark-900 z-10 absolute top-0 start-0 h-full hidden md:block"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 500 400"
        >
          <path d="M0 0l0 400L100 0Z"> </path>
        </svg>
      </div>
    </div>
  </div>
</section>
