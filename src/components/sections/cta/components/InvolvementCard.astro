---
import Paragraph from "../../../shared/Paragraph.astro";
import Title3 from "../../../shared/Title3.astro";

export interface Props {
  title: string;
  description: string;
  visual?: string;
}

const { title, description } = Astro.props;
---

<div
  class="group overflow-hidden rounded-xl h-full flex flex-col dark:bg-base-dark-800 shadow-lg dark:shadow-dark ring-1 ring-black/5 p-6 justify-between"
>
  <div class="flex flex-col gap-4">
    <div class="border-b border-primary/10 pb-3">
      <Title3 className="dark:opacity-90 font-semibold text-primary">
        {title}
      </Title3>
    </div>
    <div class="text-sm opacity-80 text-justify leading-relaxed">
      {description}
    </div>
  </div>
</div>
