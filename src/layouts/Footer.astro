---
import GroupFooterNav from "../components/blocks/GroupFooterNav.astro";
import Container from "../components/shared/Container.astro";
import FooterNav from "../components/shared/FooterNav.astro";
import Paragraph from "../components/shared/Paragraph.astro";

const footerCompany = [
  {
    itemText: "Quiénes Somos",
    itemLink: "#environment",
  },
  {
    itemText: "Casos Emblemáticos",
    itemLink: "#projects",
  },
  {
    itemText: "Trabajemos Juntos",
    itemLink: "#cta",
  },
];

const footerServices = [
  {
    itemText: "Saneamiento Financiero",
    itemLink: "#projects",
  },
  {
    itemText: "Ley 21.442",
    itemLink: "#projects",
  },
  {
    itemText: "Gestión de Infraestructura",
    itemLink: "#projects",
  },
];

const footerSupport = [
  {
    itemText: "Diagnóstico Inicial",
    itemLink: "#cta",
  },
  {
    itemText: "Asesoría a Comités",
    itemLink: "#cta",
  },
  {
    itemText: "Contacto Directo",
    itemLink: "#cta",
  },
];

const footerLegal = [
  {
    itemText: "Ley de Copropiedad",
    itemLink: "#",
  },
  {
    itemText: "Transparencia",
    itemLink: "#",
  },
  {
    itemText: "Normativa Vigente",
    itemLink: "#",
  },
];
---

<div class="relative mt-16 bg-base-200 dark:bg-base-dark-800">
  <footer class="relative pt-28 rounded-t-3xl">
    <Container className="pb-8 relative overflow-auto ">
      <div
        class="grid grid-cols-2 lg:grid-cols-3 lg:items-stretch gap-8 relative"
      >
        <div class="col-span-2 lg:col-span-1 h-auto flex flex-col">
          <div class="h-full">
            <a href="#" class="relative flex items-center gap-3">
              <div class="inline-flex text-lg font-semibold text-heading-1">
                SN Consultores
              </div>
            </a>
            <Paragraph className={"mt-8 text-justify leading-relaxed"}>
              Excelencia y rigor profesional en la administración y consultoría de comunidades. Respaldo legal, financiero y operativo bajo estrictos estándares de transparencia.
            </Paragraph>
          </div>

          <!-- firma institucional -->
          <div class="min-h-max flex items-center gap-4 text-heading-3 mt-8">
            <span class="text-sm font-medium opacity-70">Administración & Consultoría Inmobiliaria</span>
          </div>
        </div>

        <GroupFooterNav>
          <FooterNav title={"Nosotros"} navItems={footerCompany} />
          <FooterNav title={"Servicios"} navItems={footerServices} />
        </GroupFooterNav>

        <GroupFooterNav>
          <FooterNav title={"Asesoría"} navItems={footerSupport} />
          <FooterNav title={"Marco Legal"} navItems={footerLegal} />
        </GroupFooterNav>
      </div>
    </Container>
    <div class="py-4 border-t border-black/5 dark:border-white/5 relative">
      <Container>
        <div
          class="flex flex-col sm:flex-row justify-between items-center gap-4 md:text-sm text-heading-3"
        >
          <div>
            &copy; <span id="year"></span> SN Consultores. Todos los derechos reservados.
          </div>
          <div>
            <span class="font-medium">Gestión Profesional de Copropiedad</span>
          </div>
        </div>
      </Container>
    </div>
  </footer>
</div>
