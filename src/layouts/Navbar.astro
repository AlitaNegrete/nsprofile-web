---
import Container from "../components/shared/Container.astro";
import Navitem from "../components/shared/Navitem.astro";
import BtnLink from "../components/shared/BtnLink.astro";
import BtnThemeSwitch from "../components/shared/BtnThemeSwitch.astro";

const navItems = [
  {
    href: "#",
    text: "Inicio",
  },
  {
    href: "#environment",
    text: "Nosotros",
  },
  {
    href: "#projects",
    text: "Casos Reales",
  },
  {
    href: "#testimonials",
    text: "Testimonios",
  },
  {
    href: "#cta",
    text: "Proceso",
  },
];
---

<header class="absolute inset-x-0 top-0 z-50 py-6 px-6">
  <!-- <Container> -->
  <nav class="w-full flex justify-between gap-6 relative">
    <!-- logo -->
    <div class="min-w-max inline-flex relative">
      <!-- LOGO CONSTRUIDO CON CÓDIGO (SVG) -->
      <a href="/" class="relative flex items-center gap-3">
        <!-- AUMENTÉ EL TAMAÑO AQUÍ (de h-12 a h-16) para que el logo se vea más grande -->
        <div class="relative h-16 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 100" class="h-full w-auto">
            <!-- Cuadrado verde vinculado al color EXACTO de tu plantilla -->
            <rect x="0" y="10" width="70" height="70" rx="14" fill="currentColor" class="text-primary" />
            <!-- Letras SN blancas adentro del cuadrado -->
            <text x="35" y="58" font-family="system-ui, sans-serif" font-size="40" font-weight="900" fill="#ffffff" text-anchor="middle">SN</text>
            <!-- Palabra Consultores (ahora un poco más grande y gruesa) -->
            <text x="85" y="55" font-family="system-ui, sans-serif" font-size="38" font-weight="900" fill="currentColor" class="text-heading-1">Consultores</text>
            <!-- Subtítulo pequeñito vinculado al color EXACTO -->
            <text x="88" y="74" font-family="system-ui, sans-serif" font-size="12" font-weight="600" fill="currentColor" class="text-primary" letter-spacing="2">GESTIÓN INMOBILIARIA</text>
          </svg>
        </div>
      </a>
    </div>

    <div
      data-nav-overlay
      aria-hidden="true"
      class="fixed hidden inset-0 lg:!hidden bg-box-bg bg-opacity-50 backdrop-filter backdrop-blur-xl"
    >
    </div>
    <div
      data-navbar
      class="flex h-0 overflow-hidden lg:!h-auto lg:scale-y-100 duration-300 ease-linear flex-col gap-y-6 gap-x-4 lg:flex-row w-full lg:justify-between lg:items-center absolute lg:relative top-full lg:top-0 bg-body lg:bg-transparent border-x border-x-box-border lg:border-x-0"
    >
      <ul
        class="border-t border-box-border lg:border-t-0 px-6 lg:pt-0 pt-6 flex flex-col lg:flex-row gap-y-4 gap-x-3 text-lg font-medium text-heading-2 w-full lg:justify-end lg:items-center"
      >
        {
          navItems.map((item) => {
            return <Navitem {...item} />;
          })
        }
      </ul>

      <div
        class="lg:min-w-max flex items-center sm:w-max w-full pb-6 lg:pb-0 border-b border-box-bg lg:border-0 px-6 lg:px-0"
      >
        <!-- ARREGLÉ EL BOTÓN AQUÍ: cambié variant="cta" por "solid" y agregué color="primary" -->
        <BtnLink
          text="Contacto"
          href="mailto:contacto@snconsultores.cl"
          className="flex justify-center w-full sm:w-max text-lg font-semibold"
          variant="solid"
          color="primary"
        />
      </div>
    </div>

    <div class="min-w-max flex items-center gap-x-3">
      <!-- Theme Switch -->
      <BtnThemeSwitch variant="primary" />

      <!-- Navbar toggle -->
      <button
        data-toggle-nav
        data-open-nav="false"
        class="lg:hidden lg:invisible outline-none w-7 h-auto flex flex-col relative"
      >
        <span
          id="line1"
          class="w-6 h-0.5 rounded-full transition-all duration-300 ease-linear bg-heading-2"
        ></span>
        <span
          id="line2"
          class="w-6 origin-center mt-1 h-0.5 rounded-full transition-all duration-300 ease-linear bg-heading-2"
        ></span>
        <span
          id="line3"
          class="w-6 mt-1 h-0.5 rounded-full transition-all duration-300 ease-linear bg-heading-2"
        ></span>
        <span class="sr-only">Menú</span>
      </button>
    </div>
  </nav>
  <!-- </Container> -->
</header>
